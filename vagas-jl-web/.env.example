# URL base da Vagas JL API (sem barra final).
# Local: http://localhost:3000  |  Producao: URL do deploy da API na Vercel
NEXT_PUBLIC_API_URL=http://localhost:3000

# true = usa dados de demonstracao em memoria (nao chama a API). Util para
# desenvolver telas sem backend. Em producao deixe false.
NEXT_PUBLIC_API_MOCK=false

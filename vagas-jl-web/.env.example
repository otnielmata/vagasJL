# URL base da API usada pelo navegador.
#  - Direto:  http://localhost:3000 (exige CORS_ORIGIN na API)
#  - Proxy:   /backend (recomendado; configure API_PROXY_TARGET abaixo)
NEXT_PUBLIC_API_URL=/backend

# Destino do proxy /backend/* (lido no servidor/build do Next).
API_PROXY_TARGET=http://localhost:3000

# true = usa dados de demonstracao em memoria (nao chama a API).
NEXT_PUBLIC_API_MOCK=false

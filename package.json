{
  "name": "vagas-jl-api",
  "version": "1.0.0",
  "description": "API REST para conectar profissionais de testes de software a oportunidades de trabalho, com autenticacao JWT e persistencia em MongoDB.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/unit/*.test.js",
    "candidates:revalidate": "node scripts/revalidate-candidate.js",
    "candidates:sync-indexes": "node scripts/sync-candidate-indexes.js",
    "vacancies:audit-origins": "node scripts/audit-vacancy-origins.js",
    "vacancies:expire": "node scripts/expire-vacancies.js",
    "match:automation-proposal": "node scripts/print-automation-catalog-proposal.js",
    "match:programming-languages-proposal": "node scripts/print-programming-languages-catalog-proposal.js",
    "match:qa-management-proposal": "node scripts/print-qa-management-catalog-proposal.js"
  },
  "keywords": [
    "express",
    "jwt",
    "mongodb",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}

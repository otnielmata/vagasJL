# Ambiente da aplicacao: development | production | test
NODE_ENV=development

# Porta em que a API sera executada
PORT=3000

# URL base da API (usada em logs, Swagger e integracoes)
BASE_URL=http://localhost:3000

# String de conexao do MongoDB (Atlas ou instancia local)
MONGODB_URI=mongodb://localhost:27017/vagas-jl

# Segredo usado para assinar os tokens JWT (gere um valor forte e unico)
JWT_SECRET=troque-este-valor-por-um-segredo-forte
# Tempo de expiracao do token JWT (ex.: 1h, 7d, 30m)
JWT_EXPIRES_IN=1d

# Origem(ns) permitida(s) para CORS, separadas por virgula. Use * para liberar tudo (nao recomendado em producao)
CORS_ORIGIN=*

# Ambiente da aplicacao: development | production | test
NODE_ENV=development

# Porta em que a API sera executada
PORT=3000

# URL base da API (usada em logs, Swagger e integracoes)
BASE_URL=http://localhost:3000

# String de conexao do MongoDB (Atlas ou instancia local)
MONGODB_URI=mongodb://localhost:27017/vagas-jl

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obrigatorio: segredo proprio com pelo menos 32 bytes
JWT_SECRET=
# Tempo de expiracao do token JWT (ex.: 1h, 7d, 30m)
JWT_EXPIRES_IN=1d

# Origem(ns) permitida(s) para CORS, separadas por virgula. Use * para liberar tudo (nao recomendado em producao)
CORS_ORIGIN=*

# pending: validacao ainda nao configurada; mongodb: base administrada em authorized_students
STUDENT_VALIDATION_SOURCE=pending

# Aplica criterios eliminatorios explicitos no ranking personalizado
MATCH_ELIMINATORY_ENABLED=true

# Integracao protegida de engajamento oficial. Configure ambos ou deixe ambos vazios.
ENGAGEMENT_API_URL=
ENGAGEMENT_API_TOKEN=
# Timeout entre 100 e 30000 ms; cache somente em memoria entre 0 e 3600000 ms.
ENGAGEMENT_API_TIMEOUT_MS=3000
ENGAGEMENT_CACHE_TTL_MS=300000

# Hosts HTTPS e dominios de e-mail autorizados para os canais oficiais de candidatura.
# Informe somente nomes DNS, separados por virgula, sem protocolo ou caminho.
APPLICATION_ALLOWED_HOSTS=jobs.example.com
APPLICATION_ALLOWED_EMAIL_DOMAINS=example.com

# Importacao de vagas do JL Vagas (enriched-dataset.json)
IMPORT_VACANCIES_URL=https://juliodelima.com.br/vagas/data/enriched-dataset.json
IMPORT_VACANCIES_SOURCE=juliodelima-vagas
IMPORT_VACANCIES_TIMEOUT_MS=20000
# Fecha (expired) vagas que sumirem do arquivo; nunca fecha se o arquivo vier com menos de 50% das abertas
IMPORT_VACANCIES_CLOSE_MISSING=true
# Nivel usado quando o JSON so indica que o idioma e exigido (english/spanish = true)
IMPORT_VACANCIES_LANGUAGE_LEVEL=intermediate
# Segredo da Vercel Cron (GET /importacoes/vagas/sincronizar com Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
